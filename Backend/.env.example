# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/vastora-crm

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
ALLOW_ADMIN_SIGNUP=true
# ADMIN_BOOTSTRAP_SECRET=set-me-before-first-admin
ALLOW_TENANT_HEADER=false

# Cache (optional — falls back to in-memory)
REDIS_URL=

# CORS (comma-separated exact origins in production)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Email (optional — logs to console if SMTP not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Vastora CRM <noreply@vastora.tech>

# WhatsApp Business Cloud API (Messenger + MCP)
# Messenger live send needs TOKEN + PHONE_NUMBER_ID
WHATSAPP_TOKEN=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=vastora-wa-verify
# Optional Graph URL override / legacy MCP
WHATSAPP_API_URL=
# Tenant for inbound webhook messages (ObjectId string)
WHATSAPP_TENANT_ID=

# Portal URLs (for invite links)
EMPLOYEE_PORTAL_URL=http://localhost:5173
ADMIN_PORTAL_URL=http://localhost:5174

# AI Providers
AI_PROVIDER=groq
AI_TIMEOUT=30000
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_CHAT_MODEL=gpt-4o-mini
# GROQ_CHAT_MODEL=
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# Billing (optional — webhook/checkout fail closed until configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
